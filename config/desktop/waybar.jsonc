{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "modules-left": ["custom/applications", "sway/workspaces", "sway/window"],
  "modules-center": ["clock"],
  "modules-right": ["mpris", "cpu", "memory", "custom/gpu", "temperature", "custom/caffeine", "network", "bluetooth", "pulseaudio", "battery", "custom/notification", "group/tray-expander", "custom/power"],
  "custom/applications": {
    "format": "󰀻  Applications",
    "tooltip": "Applications · Meta+A\nUniversal search · Meta+Space",
    "on-click": "arcos-apps",
    "on-click-right": "arcos-settings"
  },
  "sway/workspaces": {
    "all-outputs": false,
    "disable-scroll": false,
    "format": "{name}"
  },
  "sway/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true,
    "rewrite": { "(.*) — Mozilla Firefox": "$1", "(.*) - Google Chrome": "$1" }
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "{:%A, %d %B %Y  %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%",
    "tooltip": true,
    "on-click": "kitty --class arcos-btop --title 'System Monitor' btop"
  },
  "memory": {
    "interval": 2,
    "format": "RAM {percentage}%",
    "tooltip-format": "{used:0.1f} GiB used of {total:0.1f} GiB",
    "on-click": "kitty --class arcos-btop --title 'System Monitor' btop"
  },
  "custom/gpu": {
    "exec": "arcos-gpu-usage",
    "interval": 3,
    "return-type": "json",
    "on-click": "kitty --class arcos-btop --title 'System Monitor' btop"
  },
  "temperature": {
    "critical-threshold": 85,
    "format": "{temperatureC}°C",
    "tooltip": true
  },
  "network": {
    "interval": 3,
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "",
    "format-linked": "",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname} · {ipaddr}/{cidr}\n{essid}",
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "",
    "format-connected": "  {num_connections}",
    "format-disabled": "󰂲",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "scroll-step": 3,
    "format": "{icon}  {volume}%",
    "format-bluetooth": "  {volume}%",
    "format-muted": "󰖁",
    "format-icons": { "headphone": "", "headset": "󰋎", "default": ["", "", ""] },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo} · {power} W"
  },
  "mpris": {
    "format": "{player_icon}  {dynamic}",
    "format-paused": "{status_icon}  {dynamic}",
    "player-icons": { "default": "󰎆", "spotify": "" },
    "status-icons": { "paused": "" },
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 28,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "custom/caffeine": {
    "exec": "arcos-caffeine status",
    "return-type": "json",
    "interval": 2,
    "on-click": "arcos-caffeine toggle",
    "signal": 8
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 140,
      "children-class": "tray-child"
    },
    "modules": ["custom/tray-toggle", "tray"]
  },
  "custom/tray-toggle": {
    "format": "󰇙",
    "tooltip": "Background applications"
  },
  "tray": { "icon-size": 15, "spacing": 7 },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "󰂛",
      "dnd-none": "󰪑",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/power": {
    "format": "",
    "tooltip": "Lock, suspend, log out, restart, or shut down",
    "on-click": "arcos-power-menu"
  }
}
