+fn focus_sway_window(response: &Option<QueryResponse>) -> bool {
+    if !env::var("XDG_CURRENT_DESKTOP")
+        .unwrap_or_default()
+        .to_lowercase()
+        .contains("sway")
+    {
+        return false;
+    }
+
+    let Some(item) = response
+        .as_ref()
+        .and_then(|response| response.item.as_ref())
+    else {
+        return false;
+    };
+    let app_id = item.subtext.rsplit(" · ").next().unwrap_or(&item.subtext);
+    let title = &item.text;
+
+    fn escape_criterion(value: &str) -> String {
+        value.replace('\\', "\\\\").replace('"', "\\\"")
+    }
+
+    let app_id = escape_criterion(app_id);
+    let title = escape_criterion(title);
+    // app_id covers native Wayland clients; class covers XWayland clients.
+    for property in ["app_id", "class"] {
+        let criterion = format!("[{property}=\"{app_id}\" title=\"{title}\"]");
+        let Ok(output) = Command::new("swaymsg")
+            .args(["-r", &criterion, "focus"])
+            .stdin(Stdio::null())
+            .stderr(Stdio::null())
+            .output()
+        else {
+            continue;
+        };
+        if output.status.success()
+            && String::from_utf8_lossy(&output.stdout).contains("\"success\":true")
+        {
+            return true;
+        }
+    }
+    false
+}
