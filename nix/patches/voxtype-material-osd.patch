+/// Add a continuous rounded rectangle to the current Cairo path. Keeping the
+/// window itself transparent lets the ArcOS dictation surface read as a small
+/// native Material pill instead of a rectangular application window.
+fn rounded_rect_path(cr: &Context, x: f64, y: f64, w: f64, h: f64, radius: f64) {
+    let r = radius.min(w * 0.5).min(h * 0.5);
+    let half_pi = std::f64::consts::FRAC_PI_2;
+    cr.new_sub_path();
+    cr.arc(x + w - r, y + r, r, -half_pi, 0.0);
+    cr.arc(x + w - r, y + h - r, r, 0.0, half_pi);
+    cr.arc(x + r, y + h - r, r, half_pi, std::f64::consts::PI);
+    cr.arc(
+        x + r,
+        y + r,
+        r,
+        std::f64::consts::PI,
+        std::f64::consts::PI + half_pi,
+    );
+    cr.close_path();
+}
